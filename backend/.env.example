PORT=5000

# محليًا: mongodb://127.0.0.1:27017/bilal_ibn_rabah
# على الاستضافة (Hostinger مبيقدمش MongoDB): استخدم رابط MongoDB Atlas
# مثال: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/bilal_ibn_rabah
MONGO_URI=mongodb://127.0.0.1:27017/bilal_ibn_rabah

# مفتاح تشفير التوكن - لازم يتغيّر لقيمة عشوائية طويلة وسرية في production
# ممكن تولّد واحد بالأمر: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# دومين الفرونت إند (اللي الباك إند هيسمحله بالوصول عبر CORS)
# ممكن أكتر من دومين مفصولين بفاصلة، مثال:
# CLIENT_URL=https://example.com,https://www.example.com
CLIENT_URL=http://localhost:5173

NODE_ENV=production

# بيانات الأدمن الرئيسي التي سيتم إنشاؤها عند تشغيل seed
SUPER_ADMIN_NAME=المدير العام
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=change_this_to_a_strong_password
